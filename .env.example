# Base URL of the API as seen by the browser. Same-origin; /api/* is forwarded to Django by src/proxy.ts.
NEXT_PUBLIC_API_URL=/api

# Django backend URL reachable from the Next.js server (proxy, route guard, server components).
# Use http://localhost:8000 when running `pnpm dev` outside Docker.
API_INTERNAL_URL=http://backend:8000

# Used by `pnpm gen:api` to download the OpenAPI schema (${API_URL}/api/schema/).
# API_URL=http://localhost:8000
